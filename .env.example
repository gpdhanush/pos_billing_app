# Google AdMob — client (.env is gitignored)
#
# 1) Create an AdMob account: https://admob.google.com
# 2) Add an Android app with package name: com.gk.pos_billing
# 3) Copy the App ID (ca-app-pub-xxxxxxxx~yyyyyyyy)
# 4) Create a Banner ad unit and copy its ID (ca-app-pub-xxxxxxxx/zzzzzzzz)
# 5) Paste both values below.
# 6) ALSO set the App ID in android/local.properties:
#      admobAppId=ca-app-pub-xxxxxxxx~yyyyyyyy
#    Android requires the App ID in the native manifest at build time.
#
# Google sample IDs below are for development only. Replace before Play Store.

ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
ADMOB_BANNER_AD_UNIT_ID=ca-app-pub-3940256099942544/6300978111
